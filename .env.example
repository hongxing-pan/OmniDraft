# Copy to .env. These are the paths and versions of the 3B runs.
# Do not commit a .env that contains passwords.

PYTHON=/HDDDATA/phx/tmp/omniselect/venv/bin/python
PYTHON_VERSION=3.10.20
TORCH=2.6.0+cu124
TRANSFORMERS=4.52.3
ACCELERATE=1.14.0
FLASH_ATTN=2.7.4.post1

MODEL_PATH=/HDDDATA/phx/tmp/omniselect/models/Qwen2.5-Omni-3B
OSELECT_DATA=/HDDDATA/phx/tmp/omniselect/data
AUDIOCLIP_WEIGHTS=/HDDDATA/phx/tmp/omniselect/weights/AudioCLIP-Full-Training.pt
NLTK_DATA=/home/phx/nltk_data

# PYTHONPATH must include this repo's OmniZip package and the vendored utils.
# PATH must include an ffmpeg binary or librosa raises NoBackendError.
# OSELECT_FULL=1 reads DailyOmni/qa.json and the VideoMME parquet instead of pack1000.

# Data that has to be present under OSELECT_DATA. The videos are not in git.
# DailyOmni/qa.json and DailyOmni/Videos/{id}/{id}_video.mp4
# WorldSense/worldsense_qa.json and the matching mp4s
# VideoMME/videomme/test-00000-of-00001.parquet and VideoMME/videos/data/*.mp4
